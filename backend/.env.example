# Copy to .env and fill in TEST keys. Never commit .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Set when creating the webhook in the Razorpay dashboard (different from the Key Secret)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# PostgreSQL (start it with: docker compose up -d). Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://razorpay:razorpay_dev_password@localhost:5433/razorpay
# Hosted (Neon): paste its string as is, e.g. postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Cookie flags for the refresh token (cookie is named __session, required by Firebase Hosting). COOKIE_SECURE=true requires HTTPS (localhost is exempt).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CORS: allowed browser origins, comma separated. In dev leave empty; any localhost port is allowed by regex.
# Production example: CORS_ORIGINS=https://app.example.com  and  CORS_ORIGIN_REGEX=
CORS_ORIGINS=
